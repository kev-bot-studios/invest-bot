# Copy to .env and fill in the keys you have. None are required to run with --no-llm.
# Existing environment variables take precedence over this file.

# --- LLM providers (ordered fallback; configure at least one for the LLM layer) ---
# The chain also ends in a local Ollama provider, which needs NO key — if Ollama is
# running it will be used when no cloud key is set. See README "Local fallback via Ollama".
GOOGLE_AI_STUDIO_API_KEY=
OPENROUTER_API_KEY=

# --- Optional data sources (pipeline runs without these; sources degrade gracefully) ---
FRED_API_KEY=
FINNHUB_API_KEY=
